@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["AuthWide"] = true;
}
<p class="th-eyebrow">Your account</p>
<h1 class="th-auth-title">Manage your account</h1>

<div class="th-manage">
    <aside class="th-manage-nav">
        <partial name="_ManageNav" />
    </aside>
    <section class="th-manage-body">
        @RenderBody()
    </section>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
