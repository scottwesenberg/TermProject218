@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<p class="th-eyebrow">Welcome back</p>
<h1 class="th-auth-title">Log in</h1>
<p class="th-auth-sub">Log in to write reviews and rate your favorite games.</p>

<form id="account" method="post" class="th-auth-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email or username" />
        <label asp-for="Input.Email"></label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.Password"></label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Input.RememberMe" />
        <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
    </div>
    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
</form>

<p class="th-auth-switch">
    New to AGGRO? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
</p>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <div class="th-auth-divider"><span>or</span></div>
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
        @foreach (var provider in Model.ExternalLogins!)
        {
            <button type="submit" class="btn btn-outline-light" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">Continue with @provider.DisplayName</button>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
