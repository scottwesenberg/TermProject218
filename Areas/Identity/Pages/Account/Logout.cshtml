@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}
<h1 class="th-auth-title">@ViewData["Title"]</h1>
@if (User.Identity?.IsAuthenticated ?? false)
{
    <p class="th-auth-sub">Are you sure you want to log out?</p>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
        <button type="submit" class="w-100 btn btn-lg btn-primary">Log out</button>
    </form>
}
else
{
    <p class="th-auth-sub">You've been logged out. See you next time!</p>
    <a class="w-100 btn btn-lg btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
}
