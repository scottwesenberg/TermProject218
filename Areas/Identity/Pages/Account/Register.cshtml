@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}
<p class="th-eyebrow">Join AGGRO</p>
<h1 class="th-auth-title">Create an account</h1>
<p class="th-auth-sub">Sign up to post reviews and share your take on the games you love (or don't).</p>

<form asp-route-returnUrl="@Model.ReturnUrl" method="post" class="th-auth-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="username" aria-describedby="usernameHelp" />
        <label asp-for="Input.Username"></label>
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>
    <p id="usernameHelp" class="th-auth-hint">Shown on your reviews. 3 to 20 letters, numbers, dots, dashes or underscores.</p>
    <div class="form-floating">
        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email (kept private)</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" aria-describedby="passwordHelp" />
        <label asp-for="Input.Password"></label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <p id="passwordHelp" class="th-auth-hint">At least 10 characters, with an uppercase letter, a lowercase letter, a number and a symbol (like ! or #).</p>
    <div class="form-floating">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.ConfirmPassword"></label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>
</form>

<p class="th-auth-switch">
    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
</p>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <div class="th-auth-divider"><span>or</span></div>
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
        @foreach (var provider in Model.ExternalLogins)
        {
            <button type="submit" class="btn btn-outline-light" name="provider" value="@provider.Name" title="Sign up using your @provider.DisplayName account">Continue with @provider.DisplayName</button>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
