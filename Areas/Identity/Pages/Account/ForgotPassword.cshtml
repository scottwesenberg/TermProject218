@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
<h1 class="th-auth-title">@ViewData["Title"]</h1>
<p class="th-auth-sub">Password reset emails aren't available on this demo site yet. If you're signed in, you can change your password from your account page, or just create a new account.</p>
<a class="w-100 btn btn-lg btn-primary" asp-page="./Register">Create an account</a>
