@model AllGamesGameReviews.Models.Review

@{
    ViewData["Title"] = "Edit Review";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-review-form">
        <p class="th-eyebrow mb-1">Edit review</p>
        <h1 class="th-light mb-3">@(Model.Game?.Name ?? "Edit Review")</h1>

        @if (TempData["Notice"] is string notice)
        {
            <div class="th-notice mb-3">@notice</div>
        }

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReviewId" />

            <partial name="_RatingPicker" model="Model.GameRating" />

            <div class="form-group mt-3">
                <label asp-for="GameReview" class="control-label"></label>
                <textarea asp-for="GameReview" class="form-control" rows="6" maxlength="3000"></textarea>
                <span asp-validation-for="GameReview" class="text-danger"></span>
            </div>

            <div class="th-form-actions">
                <button type="submit" class="th-btn">Save</button>
                <a class="th-btn-other text-decoration-none" asp-action="Details" asp-route-id="@Model?.ReviewId">Cancel</a>
                <a class="th-btn-other text-decoration-none" asp-action="Index">Back to Reviews</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
