@using AllGamesGameReviews.Models;
@model PaginatedList<AllGamesGameReviews.Models.Review>
@{
    ViewData["Title"] = "Reviews";
}
<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-panel-head">
        <div>
            <h1 class="th-light mb-1">Reviews</h1>
            @if (!string.IsNullOrEmpty(ViewBag.Game))
            {
                <p class="th-gold fw-semibold mb-0">@ViewBag.Game</p>
            }
        </div>
        @if (ViewBag.Game != "All Reviews")
        {
            <div class="d-flex flex-wrap gap-2">
                @if (ViewBag.GameId != null)
                {
                    <a class="th-btn rounded-3 px-3 py-2 text-decoration-none" asp-action="Create" asp-route-gameId="@ViewBag.GameId">Write a Review</a>
                }
                <a class="th-btn-other rounded-3 px-3 py-2 text-decoration-none" asp-controller="Review" asp-action="Index">View all reviews</a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="th-light">No reviews yet. Be the first to write one!</p>
    }

    @* Table on tablets and desktops *@
    <div class="table-responsive d-none d-md-block">
        <table class="table th-light th-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Rating</th>
                    <th>Game Review</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-nowrap">@Html.DisplayFor(modelItem => item.Game.Name)</td>
                        <td><span class="th-rating">@Html.DisplayFor(modelItem => item.GameRating)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.GameReview)</td>
                        <td class="text-end">
                            <a class="th-btn rounded-2 px-4 py-1 d-inline-block text-decoration-none" asp-action="Details" asp-route-id="@item.ReviewId">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Cards on phones *@
    <div class="d-md-none th-review-cards">
        @foreach (var item in Model)
        {
            <article class="th-review-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <h2 class="h6 th-light fw-semibold mb-0">@item.Game.Name</h2>
                    <span class="th-rating">@item.GameRating</span>
                </div>
                <p class="th-light mb-3">@item.GameReview</p>
                <a class="th-btn rounded-2 px-4 py-1 d-inline-block text-decoration-none" asp-action="Details" asp-route-id="@item.ReviewId">View</a>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        <nav class="th-pager" aria-label="Review pages">
            <a asp-action="Index" asp-route-gameId="@ViewBag.GameId" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-dark rounded-3 px-3 @prevDisabled">Previous</a>
            <span class="th-light">Page @Model.PageIndex of @Model.TotalPages</span>
            <a asp-action="Index" asp-route-gameId="@ViewBag.GameId" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-dark rounded-3 px-3 @nextDisabled">Next</a>
        </nav>
    }
</div>
