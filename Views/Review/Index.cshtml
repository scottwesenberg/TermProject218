@using AllGamesGameReviews.Models;
@model PaginatedList<AllGamesGameReviews.Models.ReviewGroupViewModel>
@{
    ViewData["Title"] = "Reviews";
    bool singleGame = ViewBag.GameId != null;
}
<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-panel-head">
        <div>
            <h1 class="th-light mb-1">Reviews</h1>
            @if (!string.IsNullOrEmpty(ViewBag.Game))
            {
                <p class="th-gold fw-semibold mb-0">@ViewBag.Game</p>
            }
        </div>
        @if (singleGame)
        {
            <a class="th-btn-other rounded-3 px-3 py-2 text-decoration-none" asp-controller="Review" asp-action="Index">View all reviews</a>
        }
    </div>

    @if (!Model.Any() || (singleGame && Model.All(g => g.ReviewCount == 0)))
    {
        <p class="th-light">No reviews yet. Be the first to write one!</p>
    }

    <div class="th-review-groups">
        @foreach (var group in Model)
        {
            var game = group.Game;
            <section class="th-review-group" aria-labelledby="game-@game.Id">
                <div class="th-review-side">
                    <a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id" tabindex="-1" aria-hidden="true">
                        <partial name="_GameCover" model="game" />
                    </a>
                    <h2 id="game-@game.Id" class="th-game-title mt-3">
                        <a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id">@game.Name</a>
                    </h2>
                    <div class="th-game-stats">
                        @if (group.AverageRating.HasValue)
                        {
                            <span class="th-rating" title="Average player rating">&#9733; @group.AverageRating.Value.ToString("0.0")</span>
                        }
                        <span class="th-review-count">@group.ReviewCount @(group.ReviewCount == 1 ? "review" : "reviews")</span>
                    </div>
                    <div class="th-actions th-card-actions mt-3">
                        <a class="th-btn rounded-2 text-decoration-none" asp-action="Create" asp-route-gameId="@game.Id">Write a Review</a>
                        @if (!singleGame && group.ReviewCount > group.Reviews.Count)
                        {
                            <a class="th-btn-other rounded-2 text-decoration-none" asp-action="Index" asp-route-gameId="@game.Id">All @group.ReviewCount reviews</a>
                        }
                    </div>
                </div>
                <div class="th-review-list">
                    @foreach (var review in group.Reviews)
                    {
                        <article class="th-review-card">
                            <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="th-rating">&#9733; @review.GameRating</span>
                                    <span class="th-author"><i class="fa fa-user-circle" aria-hidden="true"></i> @review.AuthorName</span>
                                </div>
                                <a class="th-review-link" asp-action="Details" asp-route-id="@review.ReviewId">View</a>
                            </div>
                            <p class="th-light mb-0">@review.GameReview</p>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        <nav class="th-pager" aria-label="Review pages">
            <a asp-action="Index" asp-route-gameId="@ViewBag.GameId" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-dark rounded-3 px-3 @prevDisabled">Previous</a>
            <span class="th-light">Page @Model.PageIndex of @Model.TotalPages</span>
            <a asp-action="Index" asp-route-gameId="@ViewBag.GameId" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-dark rounded-3 px-3 @nextDisabled">Next</a>
        </nav>
    }
</div>
