@model AllGamesGameReviews.Models.Review

@{
    ViewData["Title"] = "Review Details";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form">
        <p class="th-eyebrow mb-1">Review</p>
        <div class="th-confirm-card">
            <div class="th-confirm-cover">
                <a asp-controller="Game" asp-action="Details" asp-route-id="@Model.GameId"><partial name="_GameCover" model="Model.Game" /></a>
            </div>
            <div>
                <h1 class="th-game-title mb-2">
                    <a asp-controller="Game" asp-action="Details" asp-route-id="@Model.GameId">@Model.Game?.Name</a>
                </h1>
                <span class="th-rating">&#9733; @Model.GameRating</span>
                <p class="th-author mt-2 mb-0"><i class="fa fa-user-circle" aria-hidden="true"></i> Reviewed by @Model.AuthorName</p>
            </div>
        </div>

        <p class="th-page-text th-review-text">@Model.GameReview</p>

        <div class="th-form-actions">
            @if (ViewBag.CanModify == true)
            {
                <a class="th-btn text-decoration-none" asp-action="Edit" asp-route-id="@Model.ReviewId">Edit</a>
                <a class="th-btn-other th-btn-danger-outline text-decoration-none" asp-action="Delete" asp-route-id="@Model.ReviewId">Delete</a>
            }
            <a class="th-btn-other text-decoration-none" asp-action="Index" asp-route-gameId="@Model.GameId">More reviews for this game</a>
        </div>
    </div>
</div>
