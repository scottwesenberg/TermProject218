@model AllGamesGameReviews.Models.Review

@{
    ViewData["Title"] = "Delete Review";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form">
        <p class="th-eyebrow th-eyebrow-danger mb-1">Delete review</p>
        <h1 class="th-light mb-2">Delete this review?</h1>
        <p class="th-page-text mb-4">This permanently removes the review. This can't be undone.</p>

        <div class="th-confirm-card">
            <div class="th-confirm-cover"><partial name="_GameCover" model="Model.Game" /></div>
            <div>
                <h2 class="th-game-title mb-2">@Model.Game?.Name</h2>
                <span class="th-rating">&#9733; @Model.GameRating</span>
                <span class="th-author ms-2">by @Model.AuthorName</span>
                <p class="th-light mt-2 mb-0">@Model.GameReview</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ReviewId" />
            <div class="th-form-actions">
                <button type="submit" class="th-btn th-btn-danger">Yes, Delete Review</button>
                <a class="th-btn-other text-decoration-none" asp-action="Details" asp-route-id="@Model.ReviewId">Cancel</a>
            </div>
        </form>
    </div>
</div>
