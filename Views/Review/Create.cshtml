@model AllGamesGameReviews.Models.Review

@{
    ViewData["Title"] = "Write a Review";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-review-form">
        <p class="th-eyebrow mb-1">Write a review</p>
        <h1 class="th-light mb-3">@ViewData["GameName"]</h1>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="GameId" />

            <partial name="_RatingPicker" model="Model.GameRating" />

            <div class="form-group mt-3">
                <label asp-for="GameReview" class="control-label"></label>
                <textarea asp-for="GameReview" class="form-control" rows="6" maxlength="3000" placeholder="What did you think? What stood out, good or bad?"></textarea>
                <span asp-validation-for="GameReview" class="text-danger"></span>
            </div>

            <div class="th-form-actions">
                <button type="submit" class="th-btn">Post Review</button>
                <button type="reset" class="th-btn-other">Reset</button>
                <a class="th-btn-other text-decoration-none" asp-controller="Game" asp-action="Details" asp-route-id="@Model?.GameId">Back to Game</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
