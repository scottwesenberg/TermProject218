@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Roles";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form">
        <div class="th-panel-head">
            <div>
                <p class="th-eyebrow mb-1">Admin</p>
                <h1 class="th-light mb-0">Roles</h1>
            </div>
            <a class="th-btn rounded-3 px-3 py-2 text-decoration-none" asp-action="Create">Add Role</a>
        </div>
        <ul class="th-admin-list">
            @foreach (var role in Model)
            {
                <li>
                    <span class="th-admin-name">@role.Name</span>
                </li>
            }
        </ul>
    </div>
</div>
