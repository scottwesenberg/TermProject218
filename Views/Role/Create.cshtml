@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Add Role";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form th-form-narrow">
        <p class="th-eyebrow mb-1">Admin</p>
        <h1 class="th-light mb-4">Add a Role</h1>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Role Name</label>
                <input asp-for="Name" class="form-control" required placeholder="e.g. Moderator" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="th-form-actions">
                <button type="submit" class="th-btn">Add Role</button>
                <a class="th-btn-other text-decoration-none" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
