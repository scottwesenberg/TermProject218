@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="th-page-wrap th-div-full">
    <div class="th-page-card" style="grid-template-columns: 1fr;">
        <div class="th-page-copy">
            <p class="th-eyebrow">Critical miss</p>
            <h1 class="th-page-title">Something went wrong</h1>
            <p class="th-page-text">Sorry about that. The problem has been logged. Try again in a moment, or head back to the games.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="th-hint">Reference: <span class="th-code">@Model.RequestId</span></p>
            }
            <div class="th-form-actions">
                <a class="th-btn text-decoration-none" asp-controller="Game" asp-action="Index">Browse Games</a>
                <a class="th-btn-other text-decoration-none" asp-controller="Home" asp-action="Index">Home</a>
            </div>
        </div>
    </div>
</div>
