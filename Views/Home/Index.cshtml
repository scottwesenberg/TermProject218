@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "is-home";
}
<canvas id="goldFlakes"></canvas>

<div class="search-container d-flex justify-content-center align-items-center text-center" style="min-height: 70vh; position: relative; z-index: 10;">
    <div class="th-bg-darkblue rounded-15 th-home-search">
        <form method="post" asp-controller="Game" asp-action="IndexWithSearch" class="th-home-form">
            <label for="homeSearch" class="th-light th-home-label">Search Games</label>
            <div class="input-group input-group-lg th-home-group">
                <input id="homeSearch" type="search" class="form-control th-home-input" name="search" placeholder="Search games for reviews...">
                <button type="submit" class="th-btn th-home-btn" aria-label="Search">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>
