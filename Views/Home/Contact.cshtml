@{
    ViewData["Title"] = "Contact";
}
<div class="th-page-wrap th-div-full">
    <section class="th-page-card">
        <div class="th-page-copy">
            <p class="th-eyebrow">Get in touch</p>
            <h1 class="th-page-title">Contact Information</h1>
            <p class="th-page-text mb-3">Questions, feedback or a game you think we're missing? Visit or call us:</p>
            <address class="th-contact">
                <div class="th-contact-row">
                    <i class="fa fa-map-marker" aria-hidden="true"></i>
                    <span>1111 Front St.<br />Traverse City, MI 49694</span>
                </div>
                <div class="th-contact-row">
                    <i class="fa fa-mobile-phone" aria-hidden="true"></i>
                    <a href="tel:2311231234">231.123.1234</a>
                </div>
            </address>
        </div>
        <figure class="th-page-media">
            <img src="~/Images/reddead.png" alt="Red Dead Redemption 2 artwork" />
        </figure>
    </section>
</div>
