@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="th-page-wrap th-div-full">
    <div class="th-page-card" style="grid-template-columns: 1fr;">
        <div class="th-page-copy">
        <h1 class="th-page-title mb-3">@ViewData["Title"]</h1>
        <p class="th-page-text">AGGRO only stores what it needs to run the site: your account email and password (securely hashed) if you register, and the reviews you post.</p>
        <p class="th-page-text mb-0">We don't sell your information or share it with third parties. This site is a portfolio project.</p>
        </div>
    </div>
</div>
