@using AllGamesGameReviews.Models
@model PaginatedList<AllGamesGameReviews.Models.GameCardViewModel>

@{
    ViewData["Title"] = "Games";
    var search = ViewBag.SearchQuery as string;
    var currentSort = ViewData["CurrentSort"] as string ?? "";
    var sorts = new (string Value, string Label)[] {
        ("", "Name (A to Z)"), ("name_desc", "Name (Z to A)"), ("rating", "Highest rated"),
        ("date_desc", "Newest"), ("date", "Oldest"), ("creator", "Creator")
    };
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-panel-head">
        <h1 class="th-light mb-0">Games</h1>
        @if (User.IsInRole("Administrator") || User.IsInRole("Manager"))
        {
            <div class="d-flex flex-wrap gap-2">
                <a class="th-btn-other rounded-3 px-3 py-2 text-decoration-none" asp-action="Create">Add New Game</a>
                <a class="th-btn-other rounded-3 px-3 py-2 text-decoration-none" asp-controller="Category" asp-action="Create">Add Game Category</a>
            </div>
        }
    </div>

    <form method="get" asp-controller="Game" asp-action="Index" class="th-toolbar mb-3">
        <div class="th-search">
            <label for="gameSearch" class="visually-hidden">Search games</label>
            <input id="gameSearch" type="search" class="form-control" name="search" value="@search" placeholder="Search games, like Skyrim...">
            <button type="submit" class="th-btn rounded-2 px-3" aria-label="Search">
                <i class="fa fa-search"></i>
            </button>
        </div>
        <div class="th-sort">
            <label for="sortOrder" class="th-light">Sort by</label>
            <select id="sortOrder" name="sortOrder" class="form-select" onchange="this.form.submit()">
                @foreach (var s in sorts)
                {
                    <option value="@s.Value" selected="@(s.Value == currentSort)">@s.Label</option>
                }
            </select>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(search))
    {
        <p class="th-light mb-3">
            Search results for "@search"
            <a asp-action="Index" class="th-gold ms-2">Show all games</a>
        </p>
    }

    @if (!Model.Any())
    {
        <p class="th-light">No games found.</p>
    }

    <div class="th-game-grid">
        @foreach (var card in Model)
        {
            var game = card.Game;
            <article class="th-game-card">
                <a asp-action="Details" asp-route-id="@game.Id" class="th-game-cover-link" tabindex="-1" aria-hidden="true">
                    <partial name="_GameCover" model="game" />
                </a>
                <div class="th-game-body">
                    <h2 class="th-game-title">
                        <a asp-action="Details" asp-route-id="@game.Id">@game.Name</a>
                    </h2>
                    <p class="th-game-meta">@game.Creator &middot; @game.Year</p>
                    <div class="th-game-stats">
                        @if (card.AverageRating.HasValue)
                        {
                            <span class="th-rating" title="Average player rating">&#9733; @card.AverageRating.Value.ToString("0.0")</span>
                        }
                        else
                        {
                            <span class="th-rating th-rating-empty">No ratings</span>
                        }
                        <span class="th-review-count">@card.ReviewCount @(card.ReviewCount == 1 ? "review" : "reviews")</span>
                    </div>
                    <div class="th-actions th-card-actions">
                        <a class="th-btn-other rounded-2 text-decoration-none" asp-action="Details" asp-route-id="@game.Id">Game</a>
                        <a class="th-btn-other rounded-2 text-decoration-none" asp-controller="Review" asp-action="Index" asp-route-gameId="@game.Id">Reviews</a>
                        <a class="th-btn rounded-2 text-decoration-none" asp-controller="Review" asp-action="Create" asp-route-gameId="@game.Id">Review Game</a>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        <nav class="th-pager" aria-label="Games pages">
            <a asp-action="Index" asp-route-sortOrder="@currentSort" asp-route-search="@search" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-dark rounded-3 px-3 @prevDisabled">Previous</a>
            <span class="th-light">Page @Model.PageIndex of @Model.TotalPages</span>
            <a asp-action="Index" asp-route-sortOrder="@currentSort" asp-route-search="@search" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-dark rounded-3 px-3 @nextDisabled">Next</a>
        </nav>
    }
</div>
