@model AllGamesGameReviews.Models.Game

@{
    ViewData["Title"] = "Delete Game";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form">
        <p class="th-eyebrow th-eyebrow-danger mb-1">Delete game</p>
        <h1 class="th-light mb-2">Delete @Model.Name?</h1>
        <p class="th-page-text mb-4">This permanently removes the game. This can't be undone.</p>

        <div class="th-confirm-card">
            <div class="th-confirm-cover"><partial name="_GameCover" model="Model" /></div>
            <div>
                <h2 class="th-game-title">@Model.Name</h2>
                <p class="th-game-meta mb-2">@Model.Creator &middot; @Model.Year &middot; IGN @Model.IGNRating</p>
                <p class="th-light mb-0">@Model.Description</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="th-form-actions">
                <button type="submit" class="th-btn th-btn-danger">Yes, Delete Game</button>
                <a class="th-btn-other text-decoration-none" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
