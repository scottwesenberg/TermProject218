@model AllGamesGameReviews.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form th-form-narrow">
        <p class="th-eyebrow th-eyebrow-danger mb-1">Delete category</p>
        <h1 class="th-light mb-2">Delete "@Model.Name"?</h1>
        <p class="th-page-text mb-4">Games in this category will no longer show it. This can't be undone.</p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="th-form-actions">
                <button type="submit" class="th-btn th-btn-danger">Yes, Delete Category</button>
                <a class="th-btn-other text-decoration-none" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
