@model IEnumerable<AllGamesGameReviews.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form">
        <div class="th-panel-head">
            <div>
                <p class="th-eyebrow mb-1">Admin</p>
                <h1 class="th-light mb-0">Categories</h1>
            </div>
            <a class="th-btn rounded-3 px-3 py-2 text-decoration-none" asp-action="Create">Add Category</a>
        </div>

        <ul class="th-admin-list">
            @foreach (var item in Model)
            {
                <li>
                    <div>
                        <span class="th-admin-name">@item.Name</span>
                        <span class="th-code">@item.Id</span>
                    </div>
                    <div class="th-admin-actions">
                        <a class="th-btn-other rounded-2 text-decoration-none" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="th-btn-other th-btn-danger-outline rounded-2 text-decoration-none" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
