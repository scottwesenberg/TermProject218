@model AllGamesGameReviews.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form th-form-narrow">
        <p class="th-eyebrow mb-1">Admin</p>
        <h1 class="th-light mb-4">Add a Category</h1>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Horror" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Id" class="control-label">Short Code</label>
                <input asp-for="Id" class="form-control" maxlength="10" placeholder="e.g. HOR" style="text-transform:uppercase" />
                <small class="th-hint">A short unique code used behind the scenes. It can't be changed later.</small>
                <span asp-validation-for="Id" class="text-danger d-block"></span>
            </div>
            <div class="th-form-actions">
                <button type="submit" class="th-btn">Add Category</button>
                <a class="th-btn-other text-decoration-none" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
