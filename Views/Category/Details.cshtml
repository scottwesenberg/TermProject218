@model AllGamesGameReviews.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form th-form-narrow">
        <p class="th-eyebrow mb-1">Category</p>
        <h1 class="th-light mb-2">@Model.Name</h1>
        <p class="th-hint">Short code: <span class="th-code">@Model.Id</span></p>
        <div class="th-form-actions">
            <a class="th-btn text-decoration-none" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="th-btn-other th-btn-danger-outline text-decoration-none" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            <a class="th-btn-other text-decoration-none" asp-action="Index">Back to Categories</a>
        </div>
    </div>
</div>
