@model AllGamesGameReviews.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="th-bg-darkblue rounded-3 th-panel">
    <div class="th-form th-form-narrow">
        <p class="th-eyebrow mb-1">Admin</p>
        <h1 class="th-light mb-4">Edit Category</h1>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <p class="th-hint">Short code: <span class="th-code">@Model.Id</span></p>
            <div class="th-form-actions">
                <button type="submit" class="th-btn">Save Changes</button>
                <a class="th-btn-other text-decoration-none" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
